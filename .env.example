# Connect an Upstash Redis database to this Vercel project (Production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively, Vercel Marketplace's KV_REST_API_URL + KV_REST_API_TOKEN are supported.

# Generate a private 32-byte key once; retain it across deployments.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Connect an Upstash Redis database to this Vercel project (Production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively, Vercel Marketplace's KV_REST_API_URL + KV_REST_API_TOKEN are supported.

# Generate a private 32-byte key once; retain it across deployments.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Canonical origin for Checkout return URLs. Vercel Production can use its system domain.
APP_URL=
# Set both values from the same Stripe mode and account. Server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to false in local next dev to test Stripe Checkout instead of the demo.
# REPORT_PREVIEW_MODE=false
